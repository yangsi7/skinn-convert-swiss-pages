  "example_implementations": {
    "prime_command": {
      "file": ".claude/commands/prime.md",
      "content": "---\nallowed-tools: Read, Glob\ndescription: Initialize project context\n---\n\n## Load Project Context\n\nNavigator: @PROJECT_NAVIGATOR.json\n\n## Your Task\n1. Load the navigator file\n2. Understand project structure\n3. Prepare for exploration\n4. Report readiness with key statistics"
    },
    
    "refresh_command": {
      "file": ".claude/commands/refresh.md",
      "content": "---\nallowed-tools: Bash, Write\ndescription: Refresh project navigator\n---\n\n## Regenerate Navigator\n\nCurrent structure: !`find . -type f -name '*.ts' -o -name '*.tsx' | head -20`\n\n## Your Task\n1. Analyze current file structure\n2. Generate updated PROJECT_NAVIGATOR.json\n3. Clear .claude_cache/ if exists\n4. Report changes detected"
