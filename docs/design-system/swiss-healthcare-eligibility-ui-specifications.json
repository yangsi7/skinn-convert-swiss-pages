{
  "specification_type": "design_system",
  "name": "SKIIN Switzerland Medical Eligibility Design System",
  "version": "2.0.0",
  "created_date": "2025-08-23",
  "project_context": {
    "framework": "React 18 + TypeScript 5 + Vite",
    "styling": "Tailwind CSS + Minimal Components + Swiss Healthcare Design",
    "languages": ["en", "de", "fr", "it"],
    "compliance": ["WCAG 2.1 AA", "Swiss Data Protection", "Medical Device MDR"],
    "design_philosophy": "Minimalistic, elegant, functional with clear hierarchy"
  },

  "design_tokens": {
    "colors": {
      "primary": {
        "deep_navy": {
          "value": "#004C96",
          "rgb": "0, 76, 150",
          "hsl": "210, 100%, 29%",
          "contrast_white": "7.5:1",
          "contrast_black": "2.8:1",
          "usage": "Primary buttons, headers, active states, focus rings",
          "wcag_compliance": "AAA with white, fails with black",
          "tailwind_class": "bg-[#004C96]",
          "css_variable": "--color-primary"
        },
        "light_blue": {
          "value": "#5298F2",
          "rgb": "82, 152, 242",
          "hsl": "214, 86%, 64%",
          "contrast_white": "3.1:1",
          "contrast_black": "6.8:1",
          "usage": "Button hover states, links, interactive elements",
          "wcag_compliance": "AA Large with white, AA with black",
          "tailwind_class": "bg-[#5298F2]",
          "css_variable": "--color-primary-hover"
        }
      },
      "accent": {
        "violet": {
          "value": "#5549A6",
          "rgb": "85, 73, 166",
          "hsl": "248, 39%, 47%",
          "contrast_white": "5.8:1",
          "contrast_black": "3.6:1",
          "usage": "Accent highlights, special badges, progress indicators - use sparingly",
          "wcag_compliance": "AA with white, fails with black",
          "tailwind_class": "bg-[#5549A6]",
          "css_variable": "--color-accent",
          "note": "Use sparingly for emphasis only"
        }
      },
      "neutral": {
        "soft_beige": {
          "value": "#EEE8E1",
          "rgb": "238, 232, 225",
          "hsl": "32, 28%, 91%",
          "contrast_black": "16.3:1",
          "contrast_deep_navy": "12.2:1",
          "usage": "Soft backgrounds, card backgrounds, page sections",
          "wcag_compliance": "AAA with all dark colors",
          "tailwind_class": "bg-[#EEE8E1]",
          "css_variable": "--color-bg-soft"
        },
        "charcoal": {
          "value": "#475259",
          "rgb": "71, 82, 89",
          "hsl": "203, 11%, 31%",
          "contrast_white": "9.4:1",
          "contrast_beige": "7.1:1",
          "usage": "Secondary text, form labels, descriptions",
          "wcag_compliance": "AAA with light backgrounds",
          "tailwind_class": "text-[#475259]",
          "css_variable": "--color-text-secondary"
        },
        "black": {
          "value": "#0D0D0D",
          "rgb": "13, 13, 13",
          "hsl": "0, 0%, 5%",
          "contrast_white": "19.8:1",
          "contrast_beige": "16.3:1",
          "usage": "Primary text, headings, high emphasis content",
          "wcag_compliance": "AAA with all light colors",
          "tailwind_class": "text-[#0D0D0D]",
          "css_variable": "--color-text-primary"
        },
        "white": {
          "value": "#FFFFFF",
          "rgb": "255, 255, 255",
          "hsl": "0, 0%, 100%",
          "usage": "Card backgrounds, input backgrounds",
          "tailwind_class": "bg-white"
        }
      },
      "semantic": {
        "success": {
          "value": "#10B981",
          "rgb": "16, 185, 129",
          "hsl": "160, 84%, 39%",
          "usage": "Success messages, verified states, positive feedback",
          "wcag_compliance": "AA with white background",
          "tailwind_class": "text-green-500"
        },
        "error": {
          "value": "#EF4444",
          "rgb": "239, 68, 68",
          "hsl": "0, 84%, 60%",
          "usage": "Error messages, validation errors, destructive actions",
          "wcag_compliance": "AA with white background",
          "tailwind_class": "text-red-500"
        },
        "warning": {
          "value": "#F59E0B",
          "rgb": "245, 158, 11",
          "hsl": "38, 92%, 50%",
          "usage": "Warning messages, caution states",
          "wcag_compliance": "AA Large with white background",
          "tailwind_class": "text-amber-500"
        },
        "info": {
          "value": "#3B82F6",
          "rgb": "59, 130, 246",
          "hsl": "217, 91%, 60%",
          "usage": "Informational messages, tooltips",
          "wcag_compliance": "AA with white background",
          "tailwind_class": "text-blue-500"
        }
      },
      "alpha": {
        "navy_5": "rgba(0, 76, 150, 0.05)",
        "navy_10": "rgba(0, 76, 150, 0.10)",
        "navy_20": "rgba(0, 76, 150, 0.20)",
        "navy_50": "rgba(0, 76, 150, 0.50)",
        "charcoal_10": "rgba(71, 82, 89, 0.10)",
        "charcoal_20": "rgba(71, 82, 89, 0.20)",
        "charcoal_50": "rgba(71, 82, 89, 0.50)"
      }
    },

    "typography": {
      "font_families": {
        "primary": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "mono": "'IBM Plex Mono', 'SF Mono', Consolas, monospace"
      },
      "font_weights": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "font_sizes": {
        "xs": {
          "size": "0.75rem",
          "line_height": "1rem",
          "usage": "Helper text, footnotes, timestamps"
        },
        "sm": {
          "size": "0.875rem",
          "line_height": "1.25rem",
          "usage": "Form labels, secondary text, descriptions"
        },
        "base": {
          "size": "1rem",
          "line_height": "1.5rem",
          "usage": "Body text, form inputs, buttons"
        },
        "lg": {
          "size": "1.125rem",
          "line_height": "1.75rem",
          "usage": "Emphasized body text, card titles"
        },
        "xl": {
          "size": "1.25rem",
          "line_height": "1.75rem",
          "usage": "Section headings, modal titles"
        },
        "2xl": {
          "size": "1.5rem",
          "line_height": "2rem",
          "usage": "Page headings, hero titles"
        },
        "3xl": {
          "size": "1.875rem",
          "line_height": "2.25rem",
          "usage": "Main hero headings (desktop only)"
        }
      },
      "hierarchy": {
        "h1": {
          "size": "2xl",
          "weight": "bold",
          "color": "#0D0D0D",
          "responsive": {
            "mobile": "xl",
            "tablet": "2xl",
            "desktop": "3xl"
          }
        },
        "h2": {
          "size": "xl",
          "weight": "semibold",
          "color": "#0D0D0D"
        },
        "h3": {
          "size": "lg",
          "weight": "semibold",
          "color": "#0D0D0D"
        },
        "body": {
          "size": "base",
          "weight": "normal",
          "color": "#0D0D0D"
        },
        "body_secondary": {
          "size": "base",
          "weight": "normal",
          "color": "#475259"
        },
        "label": {
          "size": "sm",
          "weight": "medium",
          "color": "#0D0D0D"
        },
        "helper": {
          "size": "xs",
          "weight": "normal",
          "color": "#475259"
      }
    },

    "spacing": {
      "base_unit": "4px",
      "scale": {
        "0": "0px",
        "px": "1px",
        "0.5": "2px",
        "1": "4px",
        "1.5": "6px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "8": "32px",
        "10": "40px",
        "12": "48px",
        "14": "56px",
        "16": "64px",
        "20": "80px",
        "24": "96px"
      },
      "usage": {
        "component_padding": ["3", "4", "6"],
        "section_padding": ["8", "12", "16"],
        "element_gaps": ["2", "3", "4"],
        "form_spacing": ["4", "6"],
        "card_padding": ["4", "6", "8"]
      }
    },

    "borders": {
      "radius": {
        "none": "0px",
        "sm": "0.125rem",
        "default": "0.25rem",
        "md": "0.375rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
      },
      "width": {
        "thin": "1px",
        "default": "2px",
        "thick": "3px"
      },
      "colors": {
        "default": "rgba(0, 76, 150, 0.10)",
        "hover": "rgba(0, 76, 150, 0.40)",
        "focus": "#004C96",
        "error": "#EF4444",
        "subtle": "rgba(71, 82, 89, 0.10)"
      }
    },

    "shadows": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "default": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
      "focus": "0 0 0 2px rgba(0, 76, 150, 0.20)"
    },

    "transitions": {
      "duration": {
        "fast": "150ms",
        "default": "200ms",
        "slow": "300ms"
      },
      "easing": {
        "default": "ease-in-out",
        "in": "ease-in",
        "out": "ease-out",
        "spring": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
      }
    },
    "breakpoints": {
      "mobile": "375px",
      "tablet": "768px",
      "desktop": "1024px",
      "wide": "1280px"
    },
    "z_index": {
      "base": 0,
      "dropdown": 10,
      "sticky": 20,
      "overlay": 30,
      "modal": 40,
      "popover": 50,
      "tooltip": 60,
      "notification": 70
    }
  },

  "component_specifications": {
    "MinimalButton": {
      "component_name": "MinimalButton",
      "purpose": "Primary interactive element with consistent styling and states",
      "variants": {
        "primary": {
          "default": {
            "background": "#004C96",
            "text": "white",
            "border": "none"
          },
          "hover": {
            "background": "#5298F2",
            "shadow": "md"
          },
          "active": {
            "scale": "0.98"
          },
          "disabled": {
            "opacity": "0.5",
            "cursor": "not-allowed"
          }
        },
        "secondary": {
          "default": {
            "background": "transparent",
            "text": "#004C96",
            "border": "1px solid #004C96"
          },
          "hover": {
            "background": "#004C96",
            "text": "white"
          }
        },
        "ghost": {
          "default": {
            "background": "transparent",
            "text": "#004C96"
          },
          "hover": {
            "background": "rgba(0, 76, 150, 0.05)"
          }
        }
      },
      "sizes": {
        "sm": {
          "height": "32px",
          "padding": "0 12px",
          "font_size": "sm",
          "border_radius": "4px"
        },
        "md": {
          "height": "40px",
          "padding": "0 16px",
          "font_size": "sm",
          "border_radius": "4px"
        },
        "lg": {
          "height": "44px",
          "padding": "0 24px",
          "font_size": "base",
          "border_radius": "4px"
        }
      },
      "states": ["default", "hover", "active", "focus", "disabled", "loading"],
      "accessibility": {
        "focus_ring": "2px solid rgba(0, 76, 150, 0.50)",
        "focus_offset": "2px",
        "min_touch_target": "44px",
        "keyboard": "Space/Enter to activate",
        "aria_disabled": "Use when disabled",
        "aria_busy": "Use when loading"
      }
    },
    "MinimalInput": {
      "component_name": "MinimalInput",
      "purpose": "Form input with floating label support and validation states",
      "variants": {
        "default": {
          "height": "44px",
          "border": "1px solid rgba(71, 82, 89, 0.20)",
          "background": "white",
          "padding": "12px",
          "font_size": "base",
          "border_radius": "4px"
        },
        "floating_label": {
          "padding_top": "20px",
          "padding_bottom": "4px",
          "label_transition": "all 200ms ease-in-out"
        }
      },
      "states": {
        "default": {
          "border": "rgba(71, 82, 89, 0.20)"
        },
        "focus": {
          "border": "#004C96",
          "ring": "2px solid rgba(0, 76, 150, 0.20)"
        },
        "error": {
          "border": "#EF4444",
          "text": "#EF4444"
        },
        "disabled": {
          "opacity": "0.5",
          "cursor": "not-allowed",
          "background": "#EEE8E1"
        }
      },
      "accessibility": {
        "label": "Always required",
        "error_message": "Must be associated with aria-describedby",
        "required_indicator": "Asterisk with aria-label",
        "autocomplete": "Use appropriate autocomplete values"
      }
    },
    "MinimalCard": {
      "component_name": "MinimalCard",
      "purpose": "Container component for content sections with visual hierarchy",
      "variants": {
        "default": {
          "background": "white",
          "border": "1px solid rgba(0, 76, 150, 0.10)",
          "shadow": "sm"
        },
        "soft": {
          "background": "#EEE8E1",
          "border": "1px solid rgba(0, 76, 150, 0.05)"
        },
        "outlined": {
          "background": "transparent",
          "border": "1px solid rgba(0, 76, 150, 0.20)"
        },
        "clickable": {
          "cursor": "pointer",
          "hover_shadow": "lg",
          "hover_scale": "1.02",
          "active_scale": "0.98"
        }
      },
      "padding": {
        "none": "0",
        "sm": "16px",
        "md": "24px",
        "lg": "32px"
      },
      "border_radius": "8px",
      "accessibility": {
        "role": "article for content, button for clickable",
        "keyboard": "Enter/Space for clickable variants",
        "focus_visible": "2px outline offset"
      }
    },
    "FormStepper": {
      "component_name": "FormStepper",
      "purpose": "Multi-step progress indicator for 6-stage eligibility flow",
      "variants": ["horizontal", "vertical", "progress_bar"],
      "states": ["completed", "active", "upcoming", "disabled", "error"],
      "props": {
        "stages": {
          "type": "FormStage[]",
          "required": true,
          "description": "Array of form stages with steps"
        },
        "currentStage": {
          "type": "number",
          "required": true,
          "description": "Zero-based current stage index"
        },
        "currentStep": {
          "type": "number",
          "required": true,
          "description": "Zero-based current step index"
        },
        "completedStages": {
          "type": "number[]",
          "required": false,
          "description": "Array of completed stage indices"
        },
        "variant": {
          "type": "'horizontal' | 'vertical' | 'circular'",
          "default": "horizontal",
          "description": "Layout variant"
        },
        "showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show stage labels"
        },
        "animated": {
          "type": "boolean",
          "default": true,
          "description": "Enable progress animations"
        }
      },
      "responsive_behavior": {
        "mobile": "Vertical layout with collapsed future steps",
        "tablet": "Horizontal with abbreviated labels",
        "desktop": "Full horizontal with branch indicators"
      },
      "accessibility": {
        "aria_label": "Form progress indicator",
        "role": "progressbar",
        "aria_valuenow": "Current step number",
        "aria_valuemax": "Total steps",
        "screen_reader": "Announces progress and stage names"
      },
      "styling": {
        "completed_color": "bg-[#10B981]",
        "active_color": "bg-[#004C96]",
        "upcoming_color": "bg-gray-300",
        "disabled_color": "bg-gray-200",
        "error_color": "bg-[#EF4444]",
        "connector_line": "border-[#475259]/20",
        "active_connector": "border-[#004C96]",
        "progress_bar_background": "bg-[#475259]/10",
        "progress_bar_fill": "bg-[#004C96]"
      }
    },

    "OTPInput": {
      "component_name": "OTPInput",
      "purpose": "Secure OTP verification with rate limiting visualization",
      "variants": ["numeric", "alphanumeric"],
      "states": ["default", "loading", "success", "error", "disabled"],
      "props": {
        "length": {
          "type": "number",
          "default": 6,
          "description": "Number of OTP digits"
        },
        "type": {
          "type": "'numeric' | 'alphanumeric'",
          "default": "numeric",
          "description": "Input type restriction"
        },
        "autoFocus": {
          "type": "boolean",
          "default": true,
          "description": "Auto-focus first input"
        },
        "onComplete": {
          "type": "(code: string) => void",
          "required": true,
          "description": "Callback when OTP is complete"
        },
        "onResend": {
          "type": "() => void",
          "required": true,
          "description": "Resend OTP callback"
        },
        "resendDelay": {
          "type": "number",
          "default": 60,
          "description": "Resend cooldown in seconds"
        },
        "errorMessage": {
          "type": "string",
          "required": false,
          "description": "Error message to display"
        },
        "channel": {
          "type": "'email' | 'phone'",
          "required": true,
          "description": "OTP delivery method"
        },
        "maskedContact": {
          "type": "string",
          "required": false,
          "description": "Masked contact info (e.g., ****@example.com)"
        }
      },
      "ux_features": [
        "Auto-advance on digit entry",
        "Paste support for SMS/email codes",
        "Visual feedback for each digit",
        "Countdown timer with progress arc",
        "Shake animation for errors",
        "Success checkmark animation"
      ],
      "security_features": [
        "Rate limiting visualization",
        "Attempt counter display",
        "Progressive delays on failure",
        "Secure input masking"
      ],
      "accessibility": {
        "aria_label": "One-time password input",
        "aria_describedby": "Instructions and error messages",
        "keyboard_navigation": "Arrow keys between inputs",
        "screen_reader": "Live regions for status updates"
      },
      "styling": {
        "input_size": "w-12 h-14 md:w-14 md:h-14",
        "border_default": "border-2 border-[#475259]/20",
        "border_filled": "border-2 border-[#004C96] bg-[#004C96]/5",
        "border_focus": "border-[#004C96] ring-2 ring-[#004C96]/20",
        "border_error": "border-[#EF4444] ring-2 ring-[#EF4444]/10",
        "border_success": "border-[#10B981]",
        "spacing": "gap-2",
        "font_size": "text-xl font-semibold"
      }
    },

    "InsuranceSelector": {
      "component_name": "InsuranceSelector",
      "purpose": "Swiss insurance provider and model selection",
      "variants": ["grid", "list", "compact"],
      "states": ["loading", "loaded", "error", "selected"],
      "props": {
        "providers": {
          "type": "SwissInsuranceProvider[]",
          "required": true,
          "description": "Available insurance providers"
        },
        "selectedProvider": {
          "type": "string",
          "required": false,
          "description": "Selected provider ID"
        },
        "selectedModel": {
          "type": "string",
          "required": false,
          "description": "Selected model ID"
        },
        "onSelect": {
          "type": "(provider: string, model: string) => void",
          "required": true,
          "description": "Selection callback"
        },
        "showPopularBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show popular provider badges"
        },
        "groupByRegion": {
          "type": "boolean",
          "default": false,
          "description": "Group providers by region"
        },
        "enableSearch": {
          "type": "boolean",
          "default": true,
          "description": "Enable provider search"
        }
      },
      "visual_layout": {
        "provider_grid": "Grid of insurance cards with logos",
        "two_step_selection": "Provider selection → Model selection",
        "popular_badge": {
          "background": "#5549A6",
          "text": "white",
          "label": "Most Popular"
        },
        "search_filter": "Search by name or region",
        "model_details": "Expandable cards with coverage details",
        "coverage_indicators": {
          "covered": "#10B981 checkmark",
          "partial": "#F59E0B warning icon",
          "not_covered": "#EF4444 x icon"
        },
        "card_styling": {
          "default": "border-[#475259]/20 bg-white",
          "hover": "border-[#004C96] shadow-md",
          "selected": "border-[#004C96] bg-[#004C96]/5"
        }
      },
      "swiss_specific": {
        "mandatory_coverage": "LAMal/KVG indicators",
        "supplementary_options": "VVG model selection",
        "franchise_display": "Franchise amounts per model",
        "regional_grouping": "Cantonal provider grouping"
      },
      "accessibility": {
        "aria_label": "Insurance provider selection",
        "keyboard_navigation": "Arrow keys, Enter to select",
        "screen_reader": "Provider details announced",
        "focus_management": "Logical tab order"
      }
    },

    "MedicalQuestionnaire": {
      "component_name": "MedicalQuestionnaire",
      "purpose": "Medical questionnaire with conditional logic and safety checks",
      "variants": ["linear", "branching", "adaptive"],
      "states": ["active", "completed", "error", "emergency"],
      "props": {
        "questions": {
          "type": "MedicalQuestion[]",
          "required": true,
          "description": "Array of medical questions"
        },
        "onAnswer": {
          "type": "(questionId: string, answer: any) => void",
          "required": true,
          "description": "Answer callback"
        },
        "showProgressBar": {
          "type": "boolean",
          "default": true,
          "description": "Show progress indicator"
        },
        "enableSkip": {
          "type": "boolean",
          "default": false,
          "description": "Allow skipping non-required questions"
        },
        "emergencyCallback": {
          "type": "(contraindication: string) => void",
          "required": true,
          "description": "Emergency protocol callback"
        }
      },
      "ux_patterns": [
        "Progressive disclosure based on answers",
        "Medical term tooltips with explanations",
        "Visual severity indicators (green/yellow/red)",
        "Emergency alert modal for contraindications",
        "Auto-save progress with encryption",
        "Branch to emergency instructions"
      ],
      "contraindication_handling": {
        "critical_conditions": [
          "Pregnancy",
          "Pacemaker/ICD",
          "Acute chest pain",
          "Recent heart attack < 6 months",
          "Severe cardiac arrhythmia"
        ],
        "warning_conditions": [
          "Diabetes",
          "Hypertension",
          "Previous cardiac events",
          "Family cardiac history"
        ],
        "emergency_protocol": {
          "critical": {
            "action": "Block progression, show emergency contact",
            "color": "#EF4444",
            "background": "bg-red-50",
            "border": "border-red-200"
          },
          "warning": {
