  "component_specifications": {
    "ReferralCodeDisplay": {
      "component_name": "ReferralCodeDisplay",
      "purpose": "Display generated 6-character referral code after Stage 3A completion",
      "atomic_breakdown": [
        {
          "name": "ReferralCodeCard",
          "type": "organism",
          "lines": 50,
          "children": ["CodeDisplay", "QRCodeDisplay", "ShareInstructions", "CopyButton"]
        },
        {
          "name": "CodeDisplay",
          "type": "molecule",
          "lines": 35,
          "children": ["CodeText", "CodeLabel", "CopyFeedback"]
        },
        {
          "name": "QRCodeDisplay",
          "type": "molecule",
          "lines": 40,
          "children": ["QRCode", "QRLabel", "DownloadButton"]
        },
        {
          "name": "ShareInstructions",
          "type": "molecule",
          "lines": 30,
          "children": ["InstructionsList", "EmailButton", "PrintButton"]
        },
        {
          "name": "CodeText",
          "type": "atom",
          "lines": 15,
          "description": "Monospace display of 6-character code"
        },
        {
          "name": "CopyButton",
          "type": "atom",
          "lines": 20,
          "description": "Copy to clipboard with feedback"
        }
      ],
      "props": {
        "code": {
          "type": "string",
          "required": true,
          "pattern": "^[A-Z0-9]{6}$",
          "description": "6-character alphanumeric referral code"
        },
        "patientName": {
          "type": "string",
          "required": true,
          "description": "Patient name for QR code metadata"
        },
        "generatedAt": {
          "type": "Date",
          "required": true,
          "description": "Timestamp of code generation"
        },
        "expiresAt": {
          "type": "Date",
          "required": false,
          "description": "Optional expiration date (30 days default)"
        },
        "onShare": {
          "type": "(method: 'email' | 'print' | 'copy') => void",
          "required": false,
          "description": "Share action callback"
        },
        "language": {
          "type": "'en' | 'de' | 'fr' | 'it'",
          "required": true,
          "description": "Display language"
        }
      },
      "states": {
        "initial": {
          "description": "Code displayed with all sharing options",
          "visual": "Prominent code display with dashed border"
        },
        "copied": {
          "description": "After copy action",
          "visual": "Green checkmark, 'Copied!' feedback",
          "duration": "2000ms"
        },
        "shared": {
          "description": "After email/print action",
          "visual": "Success message overlay"
        },
        "expired": {
          "description": "After 30 days",
          "visual": "Greyed out with expiration notice"
        }
      },
      "visual_design": {
        "layout": {
          "container": "max-w-2xl mx-auto p-6",
          "grid": "grid grid-cols-1 md:grid-cols-2 gap-6",
          "code_section": "col-span-full text-center",
          "qr_section": "flex justify-center",
          "instructions_section": "space-y-4"
        },
        "code_display": {
          "container": "bg-white rounded-xl p-8 border-2 border-dashed border-[#004C96]/30",
          "code_text": "text-5xl font-mono font-bold text-[#004C96] tracking-widest select-all",
          "code_groups": "flex gap-3 justify-center (ABC-123 format)",
          "label": "text-sm text-[#475259] mb-2",
          "copy_button": "mt-4 bg-[#004C96] text-white px-6 py-2 rounded-lg hover:bg-[#5298F2]"
        },
        "qr_code": {
          "size": "200x200px",
          "color_dark": "#004C96",
          "color_light": "#FFFFFF",
          "error_correction": "M (15%)",
          "margin": "4 modules",
          "logo": "Optional SKIIN logo center"
        },
        "instructions": {
          "container": "bg-[#EEE8E1] rounded-lg p-4",
          "title": "text-lg font-semibold mb-3",
          "list": "space-y-2 text-sm",
          "icons": "w-5 h-5 mr-2 text-[#004C96]"
        }
      },
      "accessibility": {
        "aria_label": "Your referral code is {code}",
        "aria_live": "polite for copy feedback",
        "keyboard": "Tab navigation, Enter/Space to copy",
        "screen_reader": "Code spelled out character by character",
        "high_contrast": "Minimum 7:1 ratio for code text"
      },
      "responsive": {
        "mobile": {
          "code_size": "text-3xl",
          "layout": "stack vertically",
          "qr_size": "160x160px",
          "full_width_buttons": true
        },
        "tablet": {
          "code_size": "text-4xl",
          "layout": "2-column for QR and instructions",
          "qr_size": "180x180px"
        },
        "desktop": {
          "code_size": "text-5xl",
          "layout": "optimal spacing",
          "qr_size": "200x200px"
        }
      }
    },
    
    "DoctorUploadPortal": {
      "component_name": "DoctorUploadPortal",
      "purpose": "Standalone portal for doctors to upload signed referrals",
      "route": "/referral or /doctor-upload",
      "atomic_breakdown": [
        {
          "name": "DoctorPortalPage",
          "type": "template",
          "lines": 50,
          "children": ["PortalHeader", "ReferralCodeInput", "DoctorInfoForm", "FileUploadZone", "SubmitSection"]
        },
        {
          "name": "ReferralCodeInput",
          "type": "organism",
          "lines": 45,
          "children": ["CodeInputField", "CodeValidator", "PatientInfoDisplay"]
        },
        {
          "name": "DoctorInfoForm",
          "type": "organism",
          "lines": 50,
          "children": ["NameInput", "ClinicInput", "HINEmailInput", "PhoneInput"]
        },
        {
          "name": "FileUploadZone",
          "type": "organism",
          "lines": 50,
          "children": ["DropZone", "FilePreview", "ProgressBar", "FileValidator"]
        },
        {
          "name": "CodeInputField",
          "type": "molecule",
          "lines": 35,
          "children": ["MaskedInput", "ValidationIcon", "ErrorMessage"]
        },
        {
          "name": "HINEmailInput",
          "type": "molecule",
          "lines": 40,
          "description": "Validated HIN email with domain checking"
        },
        {
          "name": "DropZone",
          "type": "molecule",
          "lines": 45,
          "description": "Drag-and-drop file upload area"
        },
        {
          "name": "ProgressBar",
          "type": "atom",
          "lines": 20,
          "description": "Upload progress indicator"
        }
      ],
      "props": {
        "referralCode": {
          "type": "string",
          "required": false,
          "description": "Pre-filled from URL parameter"
        },
        "onSubmit": {
          "type": "(data: DoctorUploadData) => Promise<void>",
          "required": true,
          "description": "Form submission handler"
        },
        "maxFileSize": {
          "type": "number",
          "default": 10485760,
          "description": "Max file size in bytes (10MB default)"
        },
        "acceptedFormats": {
          "type": "string[]",
          "default": [".pdf", ".jpg", ".jpeg", ".png"],
          "description": "Accepted file formats"
        },
        "language": {
          "type": "'en' | 'de' | 'fr' | 'it'",
          "required": true,
          "description": "Portal language"
        }
      },
      "form_fields": {
        "referral_code": {
          "type": "text",
          "pattern": "[A-Z0-9]{6}",
          "required": true,
          "placeholder": "ABC-123",
          "mask": "XXX-XXX",
          "validation": "Real-time API check",
          "error_messages": {
            "invalid": "Invalid referral code format",
            "not_found": "Referral code not found",
            "expired": "This referral code has expired",
            "already_used": "This referral has already been uploaded"
          }
        },
        "doctor_name": {
          "type": "text",
          "required": true,
          "minLength": 2,
          "maxLength": 100,
          "placeholder": "Dr. [Name]",
          "label": "Your Name"
        },
        "clinic_practice": {
          "type": "text",
          "required": false,
          "maxLength": 200,
          "placeholder": "Clinic/Practice Name (Optional)",
          "label": "Clinic/Practice"
        },
        "hin_email": {
          "type": "email",
          "required": true,
          "pattern": ".+@hin\\.ch$",
          "placeholder": "doctor@hin.ch",
          "label": "HIN Email Address",
          "validation": "Must be valid HIN domain",
          "helper_text": "Your secure HIN email for confirmation"
        },
        "phone": {
          "type": "tel",
          "required": false,
          "pattern": "\\+41[0-9]{9}",
          "placeholder": "+41 XX XXX XX XX",
          "label": "Phone Number (Optional)",
          "mask": "+41 XX XXX XX XX"
        },
        "referral_file": {
          "type": "file",
          "required": true,
          "accept": ".pdf,.jpg,.jpeg,.png",
          "maxSize": "10MB",
          "label": "Signed Referral Document",
          "helper_text": "Upload the signed referral (PDF or image, max 10MB)"
        }
      },
      "visual_design": {
        "layout": {
          "container": "min-h-screen bg-[#F9FAFB]",
          "content": "max-w-2xl mx-auto py-12 px-6",
          "sections": "space-y-8"
        },
        "header": {
          "logo": "SKIIN logo with link to main site",
          "title": "text-3xl font-bold text-[#0D0D0D]",
          "subtitle": "text-lg text-[#475259]",
          "divider": "border-b border-[#004C96]/20 pb-6"
        },
        "code_input": {
          "container": "bg-white rounded-lg p-6 shadow-sm",
          "input": "text-2xl font-mono text-center tracking-widest",
          "validation_icon": "absolute right-3 top-1/2 transform -translate-y-1/2",
          "patient_info": "mt-4 p-4 bg-[#EEE8E1] rounded-md"
        },
        "form_section": {
          "container": "bg-white rounded-lg p-6 shadow-sm",
          "title": "text-xl font-semibold mb-4",
          "fields": "space-y-4",
          "required_indicator": "text-red-500 ml-1"
        },
        "upload_zone": {
          "container": "bg-white rounded-lg p-6 shadow-sm",
          "drop_area": "border-2 border-dashed border-[#004C96]/20 rounded-lg p-8 text-center hover:border-[#004C96]/40 hover:bg-[#004C96]/5 transition-all",
          "icon": "w-12 h-12 mx-auto mb-4 text-[#004C96]/40",
          "text": "text-sm text-[#475259]",
          "button": "mt-4 bg-[#004C96] text-white px-6 py-2 rounded-lg",
          "preview": "mt-4 p-4 bg-[#EEE8E1] rounded-md flex items-center justify-between",
          "progress": "h-2 bg-[#004C96]/10 rounded-full overflow-hidden"
        },
        "submit_section": {
          "container": "bg-white rounded-lg p-6 shadow-sm",
          "button": "w-full bg-[#004C96] text-white py-3 rounded-lg font-semibold hover:bg-[#5298F2] disabled:opacity-50",
          "terms": "text-xs text-[#475259] mt-4"
        }
      },
      "states": {
        "initial": {
          "description": "Empty form ready for input",
          "code_input": "enabled",
          "form": "disabled until code validated"
        },
        "code_validated": {
          "description": "Valid code entered, patient info shown",
          "code_input": "locked with green check",
          "form": "enabled",
          "patient_display": "visible"
        },
        "uploading": {
          "description": "File upload in progress",
          "progress_bar": "visible and animated",
          "submit_button": "disabled with spinner",
          "form": "disabled"
        },
        "success": {
          "description": "Upload successful",
          "modal": "Success message with next steps",
          "form": "hidden",
          "redirect": "After 5 seconds or manual dismiss"
        },
        "error": {
          "description": "Upload or validation error",
          "error_message": "Displayed inline",
          "form": "enabled for retry",
          "fields": "Preserve entered data"
        }
      },
      "validation": {
        "referral_code": {
          "format": "6 alphanumeric characters",
          "api_check": "Verify code exists and not used",
          "debounce": "500ms",
          "case_insensitive": true
        },
        "hin_email": {
          "domain": "@hin.ch required",
          "format": "Standard email validation",
          "unique_check": "Prevent duplicate submissions"
        },
        "file_upload": {
          "size": "Max 10MB",
          "type": "PDF, JPG, JPEG, PNG only",
          "virus_scan": "Required before processing",
          "content_check": "Verify contains signature"
        }
      },
      "accessibility": {
        "form_labels": "All fields clearly labeled",
        "required_fields": "Marked with * and aria-required",
        "error_messages": "Associated with aria-describedby",
        "progress": "Live region for upload progress",
        "keyboard_nav": "Full keyboard support",
        "screen_reader": "Status announcements"
      },
      "security": {
        "rate_limiting": "5 attempts per IP per hour",
        "code_validation": "Server-side only",
        "file_scanning": "Antivirus before storage",
        "https_only": true,
        "csrf_protection": true,
        "input_sanitization": "XSS prevention"
      }
    },
    
    "NotificationComponents": {
      "component_name": "NotificationComponents",
      "purpose": "Email templates and in-app notifications for referral system",
      "templates": {
        "doctor_confirmation_email": {
          "name": "DoctorConfirmationEmail",
          "trigger": "Successful referral upload",
          "recipients": ["doctor_hin_email"],
          "subject": {
            "en": "Referral Upload Confirmed - Patient {patientName}",
            "de": "Überweisung erfolgreich hochgeladen - Patient {patientName}",
            "fr": "Téléchargement de référence confirmé - Patient {patientName}",
            "it": "Caricamento referral confermato - Paziente {patientName}"
          },
          "sections": [
            {
              "type": "header",
              "content": "SKIIN logo and confirmation badge"
            },
            {
              "type": "greeting",
              "content": "Dear Dr. {doctorName}"
            },
            {
              "type": "confirmation",
              "content": "Referral successfully uploaded",
              "details": [
                "Patient: {patientName}",
                "Referral Code: {referralCode}",
                "Upload Date: {uploadDate}",
                "Document: {fileName}"
              ]
            },
            {
              "type": "next_steps",
              "content": "What happens next",
              "items": [
                "Patient has been notified",
                "SKIIN will process the screening",
                "You will receive the results"
              ]
            },
            {
              "type": "footer",
              "content": "Contact information and unsubscribe"
            }
          ],
          "styling": {
            "primary_color": "#004C96",
            "font_family": "system-ui, sans-serif",
            "max_width": "600px",
            "responsive": true
          }
        },
        "patient_notification_email": {
          "name": "PatientNotificationEmail",
          "trigger": "Doctor uploads referral",
          "recipients": ["patient_email"],
          "subject": {
            "en": "Your GP has uploaded the referral - Next steps",
            "de": "Ihr Hausarzt hat die Überweisung hochgeladen - Nächste Schritte",
            "fr": "Votre médecin a téléchargé la référence - Prochaines étapes",
            "it": "Il tuo medico ha caricato il referral - Prossimi passi"
          },
          "sections": [
            {
              "type": "header",
              "content": "SKIIN logo and success icon"
            },
            {
              "type": "greeting",
              "content": "Hello {patientName}"
            },
            {
              "type": "main_message",
              "content": "Great news! Your doctor has uploaded the signed referral.",
              "highlight": true
            },
            {
              "type": "doctor_info",
              "content": "Uploaded by",
              "details": [
                "Dr. {doctorName}",
                "{clinicName}",
                "Date: {uploadDate}"
              ]
            },
            {
              "type": "next_steps",
              "content": "You can now proceed with",
              "cta_button": {
                "text": "Continue to Payment",
                "url": "{continueUrl}",
                "style": "bg-[#004C96] text-white px-8 py-3 rounded-lg"
              }
            },
            {
              "type": "support",
              "content": "Need help? Contact our support team"
            }
          ]
        },
        "in_app_success": {
          "name": "InAppSuccessMessage",
          "trigger": "Various success events",
          "variants": {
            "code_generated": {
              "icon": "CheckCircle",
              "title": "Referral Code Generated",
              "message": "Your code is {code}. Share it with your GP.",
              "duration": 5000
            },
            "upload_success": {
              "icon": "Upload",
              "title": "Upload Successful",
              "message": "The referral has been uploaded successfully.",
              "duration": 5000
            },
            "code_copied": {
              "icon": "Copy",
              "title": "Copied!",
              "message": "Referral code copied to clipboard",
              "duration": 2000
            }
          },
          "styling": {
            "position": "top-right",
            "animation": "slide-in-from-right",
            "background": "#10B981",
            "text_color": "white",
            "border_radius": "8px",
            "shadow": "lg"
          }
        },
        "in_app_error": {
          "name": "InAppErrorMessage",
          "trigger": "Various error events",
          "variants": {
            "invalid_code": {
              "icon": "XCircle",
              "title": "Invalid Code",
              "message": "The referral code is not valid. Please check and try again.",
              "duration": 5000
            },
            "upload_failed": {
              "icon": "AlertTriangle",
              "title": "Upload Failed",
              "message": "Failed to upload the file. Please try again.",
              "duration": 5000
            },
            "file_too_large": {
              "icon": "AlertCircle",
              "title": "File Too Large",
              "message": "File size exceeds 10MB limit",
              "duration": 5000
            }
          },
          "styling": {
            "position": "top-right",
            "animation": "shake",
            "background": "#EF4444",
            "text_color": "white",
            "border_radius": "8px",
            "shadow": "lg"
          }
        }
      }
    }
  },
  
