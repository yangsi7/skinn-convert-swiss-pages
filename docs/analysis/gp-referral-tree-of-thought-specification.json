  "reasoning_framework": [
    {
      "decision_point": "Code Generation Method",
      "reasoning_tree": {
        "criteria": [
          "Security",
          "User experience",
          "Implementation complexity",
          "Scalability"
        ],
        "options": [
          {
            "option": "QR Code Only",
            "pros": ["Easy scanning", "Contains full data", "No typing required"],
            "cons": ["Requires camera", "Printing quality issues", "Larger storage"],
            "score": 7.5
          },
          {
            "option": "6-Digit Code Only",
            "pros": ["Easy to type", "Phone-friendly", "Minimal storage"],
            "cons": ["Collision risk", "Manual entry errors", "Limited data"],
            "score": 6.0
          },
          {
            "option": "Hybrid (QR + 6-digit)",
            "pros": ["Flexibility", "Fallback option", "Best UX"],
            "cons": ["More complex", "Dual validation needed"],
            "score": 9.0
          }
        ],
        "selected_option": "Hybrid (QR + 6-digit)",
        "rationale": "Provides maximum flexibility for both patients and doctors"
      }
    },
    {
      "decision_point": "Doctor Authentication Method",
      "reasoning_tree": {
        "criteria": [
          "Security level",
          "Swiss compliance",
          "Implementation time",
          "User friction"
        ],
        "options": [
          {
            "option": "Swiss Medical ID (HIN)",
            "pros": ["Official standard", "High trust", "Existing infrastructure"],
            "cons": ["Integration complexity", "Cost", "Not all doctors have it"],
            "score": 8.5
          },
          {
            "option": "Custom OAuth with Registry Verification",
            "pros": ["Full control", "Customizable", "Modern UX"],
            "cons": ["Build complexity", "Maintenance burden", "Trust building"],
            "score": 7.0
          },
          {
            "option": "Email OTP + Manual Verification",
            "pros": ["Simple implementation", "Low friction", "Quick start"],
            "cons": ["Lower security", "Manual process", "Scaling issues"],
            "score": 5.5
          }
        ],
        "selected_option": "Swiss Medical ID (HIN)",
        "rationale": "Industry standard ensures compliance and trust"
      }
    }
  ],
  
