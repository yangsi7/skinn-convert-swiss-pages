{
  "chain_specification": {
    "spec_id": "CHAIN-GP-REFERRAL-001",
    "version": "1.0.0",
    "created_date": "2025-11-22",
    "name": "GP Referral System Implementation Chain",
    "scope": "End-to-end implementation of GP referral functionality with QR code and 6-digit code system",
    "estimated_duration": "12-16 hours",
    "complexity": "High"
  },
  
  "execution_phases": [
    {
      "phase_id": "P1",
      "name": "Discovery & Analysis",
      "execution_type": "parallel",
      "estimated_time": "2 hours",
      "agents": [
        {
          "agent": "context-manager",
          "description": "Gather current eligibility form implementation context",
          "context_brief": "Load existing eligibility form system, database schema, and component structure",
          "expected_output": "Complete context of current eligibility implementation including EligibilityChecker.tsx, database tables, and form flow",
          "estimated_time": "30 minutes",
          "parallel_group": "discovery",
          "resource_requirements": {
            "tokens": "medium",
            "model": "sonnet"
          }
        },
        {
          "agent": "tree-of-thought-agent",
          "description": "Analyze problem space and system dependencies",
          "context_brief": "GP referral requirements, QR code generation, two-portal system architecture",
          "expected_output": "Comprehensive problem analysis with dependency tree showing relationships between patient portal, doctor portal, and database",
          "estimated_time": "45 minutes",
          "parallel_group": "discovery"
        },
        {
          "agent": "researcher",
          "description": "Research best practices for QR code systems and referral workflows",
          "context_brief": "Medical referral systems, QR code security, 6-digit code generation, Swiss healthcare standards",
          "expected_output": "Research findings on secure QR implementation, code generation algorithms, and medical referral compliance",
          "estimated_time": "45 minutes",
          "parallel_group": "discovery"
        },
        {
          "agent": "brainstormer",
          "description": "Generate creative solutions for referral package design",
          "context_brief": "Printable GP package requirements, QR/code dual system, doctor-friendly interface",
          "expected_output": "Multiple design approaches for referral package, QR positioning, code display formats",
          "estimated_time": "30 minutes",
          "parallel_group": "discovery"
        }
      ],
      "synchronization_points": [
        {
          "name": "Discovery Complete",
          "condition": "All discovery agents completed",
          "timeout": "2 hours"
        }
      ]
    },
    
    {
      "phase_id": "P2",
      "name": "Requirements & Specifications",
      "execution_type": "sequential",
      "estimated_time": "2 hours",
      "agents": [
        {
          "agent": "requirements-spec-agent",
          "description": "Create detailed requirements specification",
          "context_brief": "Discovery findings, GP referral flow, dual-portal requirements, security needs",
          "expected_output": "Complete requirements spec with user stories, acceptance criteria, and technical constraints",
          "estimated_time": "60 minutes",
          "dependencies": ["P1"],
          "resource_requirements": {
            "tokens": "high",
            "model": "sonnet"
          }
        },
        {
          "agent": "planning-task-agent",
          "description": "Create implementation plan with task breakdown",
          "context_brief": "Requirements specification, available resources, timeline constraints",
          "expected_output": "Detailed implementation plan with phases, milestones, and resource allocation",
          "estimated_time": "45 minutes",
          "dependencies": ["requirements-spec-agent"]
        }
      ]
    },
    
    {
      "phase_id": "P3",
      "name": "Security & Compliance Validation",
      "execution_type": "parallel",
      "estimated_time": "1.5 hours",
      "agents": [
        {
          "agent": "guardrails-agent",
          "description": "Validate security requirements and compliance",
          "context_brief": "Requirements spec, Swiss healthcare regulations, GDPR, data protection for medical referrals",
          "expected_output": "Security validation report with compliance checklist and risk assessment",
          "estimated_time": "45 minutes",
          "parallel_group": "validation",
          "dependencies": ["P2"]
        },
        {
          "agent": "reflection-agent",
          "description": "Review proposed architecture and identify risks",
          "context_brief": "Requirements, implementation plan, security considerations",
          "expected_output": "Architecture review with risk identification and mitigation recommendations",
          "estimated_time": "45 minutes",
          "parallel_group": "validation",
          "dependencies": ["P2"]
        }
      ]
    },
    
    {
      "phase_id": "P4",
      "name": "Database Design & Architecture",
      "execution_type": "sequential",
      "estimated_time": "2.5 hours",
      "checkpoint": true,
      "agents": [
        {
          "agent": "supabase-architect",
          "description": "Design database schema modifications",
          "context_brief": "Current schema, requirements for doctor/patient differentiation, referral linking, QR/code storage",
          "expected_output": "Database design with new tables for referrals, user roles, QR codes, and linking mechanisms",
          "estimated_time": "90 minutes",
          "dependencies": ["P3"],
          "resource_requirements": {
            "tokens": "high",
            "model": "sonnet"
          }
        },
        {
          "agent": "supabase-implementation-engineer",
          "description": "Implement database changes",
          "context_brief": "Database design from architect, migration scripts, RLS policies",
          "expected_output": "Executed migrations, created tables, implemented RLS policies, tested database operations",
          "estimated_time": "60 minutes",
          "dependencies": ["supabase-architect"]
        }
      ]
    },
    
    {
      "phase_id": "P5",
      "name": "Component Specifications",
      "execution_type": "parallel",
      "estimated_time": "2 hours",
      "agents": [
        {
          "agent": "design-system-architect",
          "description": "Design GP referral package UI components",
          "context_brief": "Printable package requirements, QR code display, 6-digit code formatting, Swiss design standards",
          "expected_output": "UI specifications for referral package, print layout, QR component, code display component",
          "estimated_time": "60 minutes",
          "parallel_group": "design",
          "dependencies": ["P4"]
        },
        {
          "agent": "frontend-developer",
          "description": "Specify doctor portal interface components",
          "context_brief": "refer.smartholter.ch requirements, QR scanner interface, code input form, upload interface",
          "expected_output": "Doctor portal component specifications with routing, forms, and data handling",
          "estimated_time": "60 minutes",
          "parallel_group": "design",
          "dependencies": ["P4"]
        },
        {
          "agent": "backend-developer",
          "description": "Design API endpoints for referral system",
          "context_brief": "Database schema, security requirements, QR generation, code validation",
          "expected_output": "API endpoint specifications for referral creation, QR generation, code validation, file upload",
          "estimated_time": "60 minutes",
          "parallel_group": "design",
          "dependencies": ["P4"]
        }
      ]
    },
    
    {
      "phase_id": "P6",
      "name": "CEO Flowchart & Documentation",
      "execution_type": "sequential",
      "estimated_time": "1.5 hours",
      "agents": [
        {
          "agent": "documentation-maintainer",
          "description": "Create CEO-ready flowchart diagram",
          "context_brief": "Complete system design, user flows, decision points, technical architecture",
          "expected_output": "Visual flowchart showing patient journey, GP interaction, data flow, and system integration",
          "estimated_time": "60 minutes",
          "dependencies": ["P5"]
        },
        {
          "agent": "reflection-agent",
          "description": "Review and validate complete solution",
          "context_brief": "All specifications, security validation, implementation plan",
          "expected_output": "Final review report with go/no-go recommendation and executive summary",
          "estimated_time": "30 minutes",
          "dependencies": ["documentation-maintainer"]
        }
      ]
    },
    
    {
      "phase_id": "P7",
      "name": "Knowledge Persistence",
      "execution_type": "parallel",
      "estimated_time": "30 minutes",
      "agents": [
        {
          "agent": "graph-memory-agent",
          "description": "Store implementation knowledge in graph",
          "context_brief": "All specifications, decisions, relationships between components",
          "expected_output": "Knowledge graph updated with GP referral entities, relationships, and observations",
          "estimated_time": "30 minutes",
          "dependencies": ["P6"]
        }
      ]
    }
  ],
  
  "conditional_logic": [
    {
      "condition": "Existing eligibility form has critical issues",
      "if_true": {
        "additional_agents": ["requirements-spec-agent"],
        "additional_tasks": ["Refactor eligibility form first", "Create migration strategy"],
        "estimated_additional_time": "2 hours"
      }
    },
    {
      "condition": "Swiss regulatory compliance requires additional verification",
      "if_true": {
        "additional_agents": ["researcher", "guardrails-agent"],
        "additional_tasks": ["Deep regulatory research", "Compliance documentation"],
        "estimated_additional_time": "1.5 hours"
      }
    }
  ],
  
  "parallel_execution_blocks": [
    {
      "block_id": "DISCOVERY-PARALLEL",
      "description": "Initial discovery and research phase",
      "agents": ["context-manager", "tree-of-thought-agent", "researcher", "brainstormer"],
      "synchronization_required": true,
      "resource_isolation": false,
      "context_sharing": {
        "shared_files": ["context/requirements.md", "src/components/home/EligibilityChecker.tsx"],
        "isolation_method": "read-only"
      }
    },
    {
      "block_id": "DESIGN-PARALLEL",
      "description": "Component and API design phase",
      "agents": ["design-system-architect", "frontend-developer", "backend-developer"],
      "synchronization_required": true,
      "resource_isolation": true,
      "context_sharing": {
        "shared_files": ["database_schema.json", "requirements_spec.json"],
        "isolation_method": "context/subagent-contexts/"
      }
    }
  ],
  
  "error_handling": [
    {
      "error_type": "Database design conflict",
      "recovery_procedure": "Re-run supabase-architect with additional constraints",
      "fallback_agents": {
        "supabase-architect": ["tree-of-thought-agent"]
      },
      "max_retries": 2
    },
    {
      "error_type": "Security validation failure",
      "recovery_procedure": "Escalate to guardrails-agent for deeper analysis",
      "checkpoint_required": true,
      "escalation_path": ["guardrails-agent", "researcher", "requirements-spec-agent"]
    }
  ],
  
  "resource_optimization": {
    "token_budget": {
      "total_estimated": "25000 tokens",
      "per_agent_breakdown": {
        "context-manager": "3000 tokens",
        "tree-of-thought-agent": "4000 tokens",
        "researcher": "3500 tokens",
        "requirements-spec-agent": "5000 tokens",
        "supabase-architect": "4500 tokens",
        "others": "5000 tokens"
      }
    },
    "model_assignments": {
      "complex_reasoning": "opus",
      "specification_creation": "sonnet",
      "validation": "sonnet",
      "documentation": "haiku"
    },
    "checkpoint_strategy": {
      "frequency": "After P2, P4, P6",
      "context_compression": "Required after P4",
      "recovery_points": ["requirements-complete", "database-ready", "specifications-done"]
    }
  },
  
  "context_passing_strategy": {
    "phase_transitions": [
      {
        "from": "P1",
        "to": "P2",
        "context_items": [
          "eligibility_form_analysis.json",
          "problem_space_tree.json",
          "best_practices_research.md",
          "design_approaches.json"
        ],
        "compression": "summarize research findings"
      },
      {
        "from": "P2",
        "to": "P3",
        "context_items": [
          "requirements_specification.json",
          "implementation_plan.json"
        ],
        "compression": "none"
      },
      {
        "from": "P3",
        "to": "P4",
        "context_items": [
          "security_validation.json",
          "architecture_review.json",
          "requirements_specification.json"
        ],
        "compression": "extract database requirements only"
      },
      {
        "from": "P4",
        "to": "P5",
        "context_items": [
          "database_schema.sql",
          "api_requirements.json",
          "ui_requirements.json"
        ],
        "compression": "none"
      }
    ],
    "context_isolation": {
      "parallel_groups": {
        "discovery": "shared read-only context",
        "validation": "isolated context per agent",
        "design": "shared schema, isolated specifications"
      }
    }
  },
  
  "deliverables_mapping": {
    "1_eligibility_understanding": {
      "source_agent": "context-manager",
      "output_file": "eligibility_form_analysis.json",
      "phase": "P1"
    },
    "2_gp_package_design": {
      "source_agent": "design-system-architect",
      "output_file": "gp_referral_package_ui.json",
      "phase": "P5"
    },
    "3_database_modifications": {
      "source_agent": "supabase-implementation-engineer",
      "output_files": ["migration.sql", "rls_policies.sql"],
      "phase": "P4"
    },
    "4_doctor_portal_specs": {
      "source_agent": "frontend-developer",
      "output_file": "doctor_portal_specifications.json",
      "phase": "P5"
    },
    "5_security_validation": {
      "source_agent": "guardrails-agent",
      "output_file": "security_compliance_report.json",
      "phase": "P3"
    },
    "6_ceo_flowchart": {
      "source_agent": "documentation-maintainer",
      "output_file": "gp_referral_flowchart.svg",
      "phase": "P6"
    },
    "7_implementation_plan": {
      "source_agent": "planning-task-agent",
      "output_file": "implementation_roadmap.json",
      "phase": "P2"
    }
  },
  
  "validation_requirements": [
    {
      "validation_point": "Before execution",
      "checks": [
        "EligibilityChecker.tsx available for analysis",
        "Database connection established",
        "All agents available and responsive",
        "Token budget allocated"
      ]
    },
    {
      "validation_point": "After P3",
      "checks": [
        "Security requirements validated",
        "Compliance gaps identified",
        "Risk assessment complete"
      ]
    },
    {
      "validation_point": "After P4",
      "checks": [
        "Database migrations tested",
        "RLS policies verified",
        "Referral linking mechanism validated"
      ]
    },
    {
      "validation_point": "Final",
      "checks": [
        "All deliverables created",
        "CEO flowchart reviewed",
        "Implementation plan approved",
        "Knowledge graph updated"
      ]
    }
  ],
  
  "success_metrics": {
    "technical": [
      "Database schema supports doctor/patient differentiation",
      "QR code generation < 100ms",
      "6-digit code validation < 50ms",
      "Referral linking 100% accurate"
    ],
    "business": [
      "GP package printable in A4 format",
      "QR code scannable from 30cm distance",
      "Doctor portal loads < 2 seconds",
      "CEO flowchart comprehensible to non-technical audience"
    ],
    "compliance": [
      "GDPR compliant data handling",
      "Swiss healthcare regulations met",
      "Security audit passed",
      "Data retention policies defined"
    ]
  },
  
  "documentation_requirements": {
    "chain_documentation": "docs/invocation-chains/gp-referral-implementation.md",
    "execution_logs": "Log all agent invocations with timestamps and outcomes",
    "knowledge_graph_updates": [
      "Create GP Referral System entity",
      "Link to Eligibility Form entity",
      "Add relationships: uses QR Code, generates 6-digit code, links referrals",
      "Store implementation decisions and rationale"
    ],
    "deliverable_locations": {
      "specifications": "docs/requirements/gp-referral/",
      "database": "supabase/migrations/gp-referral/",
      "ui_designs": "docs/design-system/gp-referral/",
      "api_docs": "docs/api/gp-referral/",
      "flowchart": "docs/diagrams/gp-referral-flowchart.svg"
    }
  }
}