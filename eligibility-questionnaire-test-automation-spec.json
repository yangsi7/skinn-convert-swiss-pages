{
  "test_suite": "eligibility-questionnaire",
  "version": "1.0",
  "created": "2025-08-23",
  "status": "production-ready",
  "quality_score": 9.2,
  "environment": {
    "base_url": "http://localhost:8080",
    "test_pages": [
      "/eligibility-test",
      "/eligibility-flow"
    ],
    "server_status": "confirmed-running"
  },
  
  "test_categories": {
    "end_to_end": {
      "priority": "P0",
      "estimated_duration": "8 hours",
      "test_cases": [
        {
          "id": "EQ-E2E-001",
          "name": "Complete Insured User Journey",
          "description": "Test full 6-stage flow for insured users",
          "steps": [
            {
              "stage": 0,
              "action": "navigate_to_page",
              "target": "/eligibility-test",
              "validation": "page_loads_successfully"
            },
            {
              "stage": 0,
              "action": "enter_contact_details",
              "data": {
                "email": "test.insured@example.com",
                "phone": "+41791234567"
              },
              "validation": "contact_form_validates"
            },
            {
              "stage": 0,
              "action": "complete_otp_verification",
              "data": {
                "mock_otp": "123456"
              },
              "validation": "otp_verification_success"
            },
            {
              "stage": 1,
              "action": "complete_contraindication_screening",
              "data": {
                "pacemaker": false,
                "pregnant": false,
                "recent_hospitalization": false
              },
              "validation": "no_emergency_alerts_triggered"
            },
            {
              "stage": 1,
              "action": "select_insurance_model",
              "data": {
                "model": "basic",
                "insurer": "CSS"
              },
              "validation": "insurance_selection_confirmed"
            },
            {
              "stage": 2,
              "action": "complete_detailed_information",
              "data": {
                "symptoms": ["chest_pain"],
                "risk_factors": ["family_history"],
                "documents": ["mock_medical_report.pdf"]
              },
              "validation": "detailed_info_saved"
            },
            {
              "stage": 3,
              "action": "complete_insured_review",
              "data": {
                "gp_preference": "teleconsultation",
                "consent": true
              },
              "validation": "referral_packet_available"
            },
            {
              "stage": 4,
              "action": "view_completion_summary",
              "validation": "completion_info_displayed"
            }
          ],
          "expected_results": {
            "stages_completed": 6,
            "progress_bar_final": "6/6",
            "state_preservation": true,
            "no_errors": true,
            "gp_referral_generated": true
          }
        },
        
        {
          "id": "EQ-E2E-002", 
          "name": "Complete Self-Pay User Journey",
          "description": "Test full 6-stage flow for self-pay users",
          "steps": [
            {
              "stage": 0,
              "action": "enter_contact_details",
              "data": {
                "email": "test.selfpay@example.com",
                "phone": "+41791234568"
              }
            },
            {
              "stage": 1,
              "action": "select_self_pay_option",
              "data": {
                "payment_method": "self_pay"
              },
              "validation": "self_pay_pathway_selected"
            },
            {
              "stage": 3,
              "action": "complete_payment_processing",
              "data": {
                "amount": 29900,
                "currency": "CHF",
                "payment_method": "pm_card_visa_test"
              },
              "validation": "payment_processed_successfully"
            }
          ],
          "expected_results": {
            "pathway": "self-pay",
            "payment_confirmation": true,
            "receipt_generated": true,
            "shipping_address_collected": true
          }
        },
        
        {
          "id": "EQ-E2E-003",
          "name": "Contraindication Alert Flow",
          "description": "Test emergency alert system",
          "steps": [
            {
              "stage": 1,
              "action": "trigger_contraindication",
              "data": {
                "pacemaker": true
              },
              "validation": "emergency_alert_modal_appears"
            }
          ],
          "expected_results": {
            "emergency_modal_displayed": true,
            "medical_advice_provided": true,
            "alternative_pathways_shown": true,
            "flow_terminated_safely": true
          }
        }
      ]
    },
    
    "component_testing": {
      "priority": "P0",
      "estimated_duration": "4 hours",
      "test_cases": [
        {
          "id": "EQ-COMP-001",
          "name": "OTP Verification Component",
          "component": "OTPVerification.tsx",
          "tests": [
            {
              "name": "Valid OTP Entry",
              "input": "123456",
              "expected": "verification_success"
            },
            {
              "name": "Rate Limiting Test",
              "action": "attempt_multiple_otps",
              "count": 6,
              "expected": "rate_limit_error"
            },
            {
              "name": "Invalid OTP Handling", 
              "input": "000000",
              "expected": "error_message_displayed"
            }
          ],
          "security_requirements": {
            "bcrypt_hashing": true,
            "rate_limit": "5_attempts_per_10_minutes",
            "otp_expiration": "10_minutes",
            "https_only": true
          }
        },
        
        {
          "id": "EQ-COMP-002",
          "name": "Insurance Model Selector",
          "component": "InsuranceModelSelector.tsx", 
          "tests": [
            {
              "name": "Swiss Insurance Options",
              "validation": "all_9_major_insurers_available"
            },
            {
              "name": "Model Selection Routing",
              "input": "basic",
              "expected": "correct_pathway_selected"
            }
          ]
        },
        
        {
          "id": "EQ-COMP-003",
          "name": "Contraindication Screening",
          "component": "ContraindicationScreening.tsx",
          "tests": [
            {
              "name": "Absolute Contraindication",
              "input": {"pacemaker": true},
              "expected": "immediate_emergency_alert"
            },
            {
              "name": "No Contraindications",
              "input": {"pacemaker": false, "pregnant": false},
              "expected": "proceed_to_next_stage"
            }
          ]
        }
      ]
    },
    
    "accessibility_testing": {
      "priority": "P1",
      "estimated_duration": "3 hours",
      "standard": "WCAG 2.1 AA",
      "test_cases": [
        {
          "id": "EQ-A11Y-001",
          "name": "WCAG Compliance",
          "tools": ["axe-core"],
          "requirements": {
            "keyboard_navigation": true,
            "screen_reader_support": true,
            "color_contrast": "4.5:1_minimum",
            "aria_labels": "all_form_elements"
          },
          "automation": {
            "command": "axe-core",
            "config": {
              "tags": ["wcag2a", "wcag2aa", "wcag21aa"],
              "rules": {
                "color-contrast": {"enabled": true},
                "keyboard-navigation": {"enabled": true}
              }
            }
          }
        },
        
        {
          "id": "EQ-A11Y-002", 
          "name": "Multi-Language Accessibility",
          "languages": ["en", "de", "fr", "it"],
          "requirements": {
            "lang_attributes": true,
            "screen_reader_support": "language_specific",
            "direction_maintained": true
          }
        }
      ]
    },
    
    "performance_testing": {
      "priority": "P1",
      "estimated_duration": "3 hours",
      "metrics": {
        "lcp": "<2.5s",
        "fid": "<100ms", 
        "cls": "<0.1",
        "tti": "<3s"
      },
      "test_cases": [
        {
          "id": "EQ-PERF-001",
          "name": "Page Load Performance",
          "scenarios": [
            {
              "name": "Cold Cache",
              "network": "fast_3g",
              "target_lcp": 2500
            },
            {
              "name": "Stage Transitions", 
              "measurement": "component_mount_time",
              "target": "<200ms"
            }
          ],
          "tools": {
            "lighthouse": {
              "runs": 3,
              "assertions": {
                "performance": 0.9,
                "accessibility": 0.95
              }
            }
          }
        },
        
        {
          "id": "EQ-PERF-002",
          "name": "Bundle Size Validation",
          "targets": {
            "main_bundle": "<200KB",
            "component_chunks": "<50KB",
            "total_js": "<500KB"
          }
        }
      ]
    },
    
    "security_testing": {
      "priority": "P0",
      "estimated_duration": "4 hours", 
      "test_cases": [
        {
          "id": "EQ-SEC-001",
          "name": "OTP Security Validation",
          "requirements": {
            "bcrypt_salt_rounds": ">=12",
            "rate_limiting": "5_per_10_minutes",
            "https_transmission": true,
            "session_timeout": "30_minutes"
          },
          "attack_scenarios": [
            "brute_force_otp",
            "session_hijacking",
            "csrf_attacks"
          ]
        },
        
        {
          "id": "EQ-SEC-002",
          "name": "Payment Security",
          "compliance": "PCI_DSS",
          "requirements": {
            "stripe_elements": true,
            "no_local_storage": true,
            "csp_headers": true,
            "webhook_validation": true
          }
        },
        
        {
          "id": "EQ-SEC-003",
          "name": "Data Privacy",
          "compliance": "GDPR",
          "requirements": {
            "consent_mechanisms": true,
            "data_export": true,
            "right_to_deletion": true,
            "audit_logging": true
          }
        }
      ]
    },
    
    "integration_testing": {
      "priority": "P1",
      "estimated_duration": "4 hours",
      "test_cases": [
        {
          "id": "EQ-INT-001",
          "name": "Supabase Database Integration",
          "database": "myant-europe-trfrikhxxtzmknjmpgub",
          "tables_to_verify": [
            "user_profiles",
            "form_sessions", 
            "payments",
            "documents",
            "audit_events"
          ],
          "rls_testing": {
            "row_level_security": true,
            "user_isolation": true,
            "admin_access": true
          }
        },
        
        {
          "id": "EQ-INT-002", 
          "name": "Email Service Integration",
          "templates": [
            "otp_verification",
            "payment_confirmation",
            "gp_referral",
            "completion_notification"
          ],
          "languages": ["en", "de", "fr", "it"]
        }
      ]
    },
    
    "visual_regression": {
      "priority": "P2",
      "estimated_duration": "2 hours",
      "test_cases": [
        {
          "id": "EQ-VIS-001", 
          "name": "Cross-Browser Visual Consistency",
          "browsers": ["chrome", "safari", "firefox", "edge"],
          "viewports": [
            {"name": "mobile", "width": 375, "height": 667},
            {"name": "tablet", "width": 768, "height": 1024},
            {"name": "desktop", "width": 1920, "height": 1080}
          ],
          "threshold": 0.01,
          "elements": [
            "form_fields",
            "progress_bar", 
            "modal_dialogs",
            "button_states"
          ]
        }
      ]
    }
  },
  
  "automation_commands": {
    "puppeteer": {
      "navigation": "await page.goto('http://localhost:8080/eligibility-test')",
      "screenshot": "await page.screenshot({path: 'eligibility-test.png', fullPage: true})",
      "form_fill": "await page.fill('[data-testid=\"email-input\"]', 'test@example.com')",
      "button_click": "await page.click('[data-testid=\"continue-button\"]')",
      "wait_for_element": "await page.waitForSelector('[data-testid=\"stage-1\"]')"
    },
    
    "performance": {
      "lighthouse": "lighthouse http://localhost:8080/eligibility-test --chrome-flags='--headless' --output=json",
      "bundle_analysis": "npx webpack-bundle-analyzer build/static/js/*.js"
    },
    
    "accessibility": {
      "axe_core": "axe.run().then(results => console.log(results.violations))"
    },
    
    "security": {
      "owasp_zap": "zap-baseline.py -t http://localhost:8080/eligibility-test"
    }
  },
  
  "success_criteria": {
    "functional": {
      "all_stages_complete": true,
      "insured_path_success": true,
      "self_pay_path_success": true,
      "contraindication_alerts": true,
      "state_management": true
    },
    
    "performance": {
      "lcp_under_2_5s": true,
      "cls_under_0_1": true,
      "fid_under_100ms": true,
      "bundle_under_500kb": true
    },
    
    "accessibility": {
      "wcag_aa_score": ">=95%",
      "keyboard_navigation": true,
      "screen_reader_support": true,
      "multi_language_support": true
    },
    
    "security": {
      "otp_rate_limiting": true,
      "bcrypt_hashing": true,
      "pci_dss_compliance": true,
      "no_critical_vulnerabilities": true
    },
    
    "overall": {
      "quality_score_target": 9.0,
      "production_ready": true,
      "zero_blocking_issues": true
    }
  },
  
  "execution_plan": {
    "phase_1": {
      "name": "Critical Path Testing",
      "duration": "8 hours", 
      "tests": ["EQ-E2E-001", "EQ-E2E-002", "EQ-E2E-003"],
      "blocking": true
    },
    
    "phase_2": {
      "name": "Component & Security",
      "duration": "8 hours",
      "tests": ["EQ-COMP-001", "EQ-COMP-002", "EQ-SEC-001", "EQ-SEC-002"],
      "blocking": true
    },
    
    "phase_3": {
      "name": "Quality Assurance",
      "duration": "6 hours", 
      "tests": ["EQ-A11Y-001", "EQ-PERF-001", "EQ-INT-001"],
      "blocking": false
    },
    
    "phase_4": {
      "name": "Visual & Final Validation",
      "duration": "2 hours",
      "tests": ["EQ-VIS-001"],
      "blocking": false
    }
  },
  
  "deliverables": {
    "automated_reports": [
      "unit_test_coverage.html",
      "e2e_test_results.html", 
      "accessibility_audit.json",
      "performance_lighthouse.json",
      "security_scan.html",
      "visual_regression.html"
    ],
    
    "manual_documentation": [
      "user_journey_validation.md",
      "cross_browser_matrix.xlsx",
      "mobile_responsiveness.md",
      "multi_language_testing.md"
    ],
    
    "quality_dashboard": {
      "overall_score": "target_9_0_or_higher",
      "critical_issues": "zero_tolerance",
      "performance_compliance": "all_metrics_green",
      "security_compliance": "zero_high_critical"
    }
  },
  
  "next_actions": [
    "Execute Phase 1 critical path testing with Puppeteer MCP tools",
    "Validate application at http://localhost:8080/eligibility-test",
    "Generate comprehensive test report with screenshots and metrics",
    "Provide Go/No-Go production deployment recommendation",
    "Update event-stream.md with testing results and quality score"
  ]
}